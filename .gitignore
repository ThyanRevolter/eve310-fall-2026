# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv / virtual environments
.venv/
venv/
.uv-cache/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Instructor-only material: keep solutions out of the student-facing repo
solutions/
*_solution.ipynb
*_solutions.ipynb
*_key.*
# Gradescope autograders embed the answer key (see labs/*/autograder/README.md).
# Remove this line only if the repository is private to course staff.
labs/*/autograder/

# Figures produced by running the lab notebooks. Keeping these untracked means a
# student who runs a lab still has a clean tree the next time they `git pull`.
labs/*/figures/*
assignments/*/figures/*
!**/figures/.gitkeep

# Large or generated data (commit small teaching datasets explicitly with `git add -f`)
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/**/README.md
*.csv.gz
*.zip
*.h5
*.nc
*.sqlite

# LaTeX / Beamer build artifacts
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# Arduino build artifacts
build*/
*.hex

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
.env
*.lic

# Jekyll (GitHub Pages site in docs/)
docs/_site/
docs/.jekyll-cache/
docs/.sass-cache/
docs/.bundle/
docs/vendor/
